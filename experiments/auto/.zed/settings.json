{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!sqlts",
        "!reylo-compose-preview",
        "!vtsls",
        "!typescript-language-server"
      ],
      "semantic_tokens": "combined"
    }
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "bun",
        "arguments": [
          "--no-env-file",
          "--config=../../editors/zed/server.bunfig.toml",
          "../../scripts/auto-server.ts",
          "--project",
          "."
        ]
      }
    }
  }
}
