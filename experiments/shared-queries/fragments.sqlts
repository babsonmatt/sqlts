import { sql } from "@sqlts/core";

// Explicit fragment spelling makes this safe to reuse without defining a query.
// Each consumer must provide the `u` alias with compatible columns.
export function inOrganization(orgId: number) {
  return sql.fragment`u.org_id = ${orgId}`;
}

export function matchesSearch(search: string) {
  const pattern = `%${search}%`;
  return sql.fragment`(u.name ILIKE ${pattern} OR u.email ILIKE ${pattern})`;
}

export const hasEmail = sql.fragment`u.email IS NOT NULL`;
