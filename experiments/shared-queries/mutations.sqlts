import { sql } from "reylo-sqlts-experiment";
import { inOrganization } from "./fragments.sqlts";

export function insertUser(id: number, orgId: number, name: string) {
  return sql`
    INSERT INTO reylo_inline_demo.users (id, org_id, name)
    VALUES (${id}, ${orgId}, ${name})
    RETURNING id, name, email
  `;
}

export function updateName(orgId: number, id: number, name: string, clearEmail = false) {
  return sql`
    UPDATE reylo_inline_demo.users AS u
    SET name = ${name} ${clearEmail ? sql`, email = NULL` : sql.empty}
    WHERE ${inOrganization(orgId)} AND u.id = ${id}
    RETURNING u.id, u.name, u.email
  `;
}

export function upsertUser(id: number, orgId: number, name: string) {
  return sql`
    INSERT INTO reylo_inline_demo.users AS u (id, org_id, name)
    VALUES (${id}, ${orgId}, ${name})
    ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name
    WHERE u.org_id = EXCLUDED.org_id
    RETURNING u.id, u.name, u.email
  `;
}

export function insertUsers(orgId: number, ids: number[], names: string[]) {
  if (ids.length !== names.length) throw new Error("Each ID needs a name");
  return sql`
    INSERT INTO reylo_inline_demo.users (id, org_id, name)
    SELECT input.id, ${orgId}, input.name
    FROM unnest(${ids}::int[], ${names}::text[]) AS input(id, name)
    RETURNING id, name
  `;
}

export function deleteUser(orgId: number, id: number) {
  return sql`
    DELETE FROM reylo_inline_demo.users AS u
    WHERE ${inOrganization(orgId)} AND u.id = ${id}
    RETURNING u.id
  `;
}

export function deleteWithoutReturning(orgId: number, id: number) {
  return sql`
    DELETE FROM reylo_inline_demo.users AS u
    WHERE ${inOrganization(orgId)} AND u.id = ${id}
  `;
}
