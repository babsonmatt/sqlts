{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "contentMappers": [{ "package": "reylo-sqlts-experiment", "extensions": [".sqlts"] }],
  "files": ["queries.sqlts", "consumer.ts", "narrowing.ts"]
}
