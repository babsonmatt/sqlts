{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "contentMappers": [{ "package": "@sqlts/core", "extensions": [".sqlts"] }],
  "include": ["*.ts", "*.sqlts"],
  "exclude": ["plugin"]
}
