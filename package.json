{
  "name": "reylo-inline-sql-experiment",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "reylo-inline-preview": "src/sqlts/preview-cli.ts"
  },
  "workspaces": [
    "experiments/sqlts/plugin"
  ],
  "type": "module",
  "scripts": {
    "db:seed": "bun scripts/seed.ts",
    "generate": "bun scripts/generate.ts",
    "demo": "bun examples/demo.ts",
    "test": "bun test tests",
    "typecheck": "bun run generate && bun run typecheck:bun",
    "typecheck:tsgo": "tsgo --project tsconfig.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:type-aware": "oxlint . --tsconfig tsconfig.json --type-aware",
    "lint:type-check": "oxlint . --tsconfig tsconfig.json --type-aware --type-check",
    "lint:tsgo": "tsgolint --tsconfig tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "check": "bun run typecheck && bun run sqlts:check:all && bun run test && bun run lint:type-check && bun run format:check && bun run test:bundle && bun run test:watch",
    "build": "bun build examples/demo.ts --target=bun --outdir=dist",
    "test:bundle": "bun scripts/check-bundle.ts",
    "bench:runtime": "bun scripts/bench.ts",
    "demo:ide": "bun examples/ide-demo.ts",
    "dev:types": "bun scripts/watch.ts",
    "inspect": "bun --no-env-file scripts/inspect.ts",
    "preview:server": "bun --no-env-file scripts/preview-server.ts",
    "bench:preview": "bun --no-env-file scripts/bench-preview.ts",
    "test:watch": "bun scripts/check-watch.ts",
    "typecheck:bun": "bun check --no-script",
    "bench:completion": "bun scripts/bench-completion.ts",
    "bench:sqlts:types": "bun scripts/bench-sqlts-types.ts",
    "experiment:nameless": "bun scripts/probe-nameless.ts",
    "auto:check": "bun scripts/auto.ts check",
    "auto:demo": "bun scripts/auto.ts run demo.ts",
    "auto:build": "bun scripts/auto.ts build demo.ts",
    "auto:generate": "bun scripts/auto.ts generate",
    "auto:editor": "bun --no-env-file scripts/auto-server.ts",
    "sqlts:check": "node --env-file=.env node_modules/typescript/bin/tsc --noEmit --runExternalCode -p experiments/sqlts/tsconfig.json",
    "sqlts:demo": "node --env-file=.env --import @sqlts/core/register experiments/sqlts/demo.ts",
    "sqlts:demo:bun": "bun --preload @sqlts/core/register experiments/sqlts/demo.ts",
    "bench:compare": "bun scripts/comparison/run.ts",
    "sqlts:advanced": "bun --preload @sqlts/core/register experiments/advanced-queries/consumer.ts",
    "sqlts:advanced:check": "node --env-file=.env node_modules/typescript/bin/tsc --noEmit --runExternalCode -p experiments/advanced-queries/tsconfig.json",
    "sqlts:advanced:test": "bun --preload @sqlts/core/register experiments/advanced-queries/verify.ts",
    "sqlts:pack": "bun scripts/pack-sqlts.ts",
    "sqlts:build": "bun src/sqlts/cli.ts build",
    "sqlts:shared:check": "node --env-file=.env node_modules/typescript/bin/tsc --noEmit --runExternalCode -p experiments/shared-queries/tsconfig.json",
    "sqlts:reuse": "bun --preload @sqlts/core/register experiments/shared-queries/reuse-demo.ts",
    "sqlts:shared": "bun --preload @sqlts/core/register experiments/shared-queries/consumer.ts",
    "sqlts:check:all": "bun scripts/check-sqlts.ts",
    "bench:sqlts:project": "bun scripts/bench-sqlts-project.ts",
    "dbmate:install": "bun scripts/migrations/install-dbmate.ts",
    "demo:migrations": "bun scripts/migrations/demo.ts",
    "sqlts:refresh": "node src/sqlts/cli.ts refresh-schema --project .",
    "bench:sqlts:stress": "bun scripts/bench-sqlts-stress.ts"
  },
  "dependencies": {
    "reylo": "0.6.0"
  },
  "devDependencies": {
    "@reylosql/postgres": "0.6.0",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "@sqlts/core": "workspace:*",
    "typescript": "7.1.0-beta",
    "typescript-ast": "npm:typescript@5.9.3",
    "vite": "8.3.5"
  }
}
