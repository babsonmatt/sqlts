{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "sqlts",
        "typescript-ls",
        "!reylo-compose-preview",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "semantic_tokens": "combined"
    },
    "TSX": {
      "language_servers": [
        "sqlts",
        "typescript-ls",
        "!reylo-compose-preview",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ],
      "semantic_tokens": "combined"
    }
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "node_modules/typescript/bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      },
      "initialization_options": {
        "runExternalCode": true
      }
    }
  },
  "file_types": {
    "TypeScript": ["sqlts"]
  }
}
